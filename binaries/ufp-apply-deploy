#!/bin/sh
# ufp 部署包应用脚本（root 运行）。
#
# 两个入口都用它：
#   1) 网关的 /admin/api/deploy（CI 通过域名推上来的包）——
#      网关以 ufp 用户跑，通过 sudo/doas 调这个脚本，脚本再解包、安装/升级；
#   2) 人工在服务器上执行（把包 scp 上来）。
#
# 用法：
#   ufp-apply-deploy <tar.gz> [期望的 sha256]
#
# 脚本只做三件事：校验哈希 → 解到临时目录 → 交给包里的 remote-deploy.sh。
# 真正的安装/升级/健康检查/回滚逻辑放在包里（跟着版本走），这样升级逻辑本身
# 也能随发布一起更新。
set -eu

TARBALL="${1:?用法: ufp-apply-deploy <tar.gz> [sha256]}"
EXPECTED="${2:-}"
LOG_TAG="[ufp-apply]"

log() { echo "$LOG_TAG $*"; }

[ "$(id -u)" = "0" ] || { echo "$LOG_TAG 需要 root 运行" >&2; exit 1; }
[ -f "$TARBALL" ] || { echo "$LOG_TAG 找不到归档：$TARBALL" >&2; exit 1; }

# 1) 校验哈希（CI 路径必带；人工路径可选）
if [ -n "$EXPECTED" ]; then
  ACTUAL=$(sha256sum "$TARBALL" | awk '{print $1}')
  if [ "$ACTUAL" != "$EXPECTED" ]; then
    echo "$LOG_TAG sha256 不匹配：期望 $EXPECTED，实际 $ACTUAL" >&2
    exit 1
  fi
  log "sha256 校验通过"
fi

# 2) 解到临时舞台
STAGE=$(mktemp -d /tmp/ufp-deploy.XXXXXX)
cleanup() { rm -rf "$STAGE"; }
trap cleanup EXIT INT TERM
tar xzf "$TARBALL" -C "$STAGE"
if [ ! -f "$STAGE/ufp" ] && [ ! -f "$STAGE/ufp-x86_64-unknown-linux-musl" ] \
   && [ ! -f "$STAGE/ufp-aarch64-unknown-linux-musl" ]; then
  echo "$LOG_TAG 归档里没有 ufp 二进制" >&2
  exit 1
fi
[ -f "$STAGE/remote-deploy.sh" ] || { echo "$LOG_TAG 归档里没有 remote-deploy.sh" >&2; exit 1; }
chmod +x "$STAGE"/ufp* "$STAGE/remote-deploy.sh" 2>/dev/null || true

# 顺便把 apply 脚本自己更新到最新（下次部署就能用上新逻辑）
if [ -f "$STAGE/ufp-apply-deploy" ] && [ -d "$(dirname "$0")" ]; then
  if ! cmp -s "$STAGE/ufp-apply-deploy" "$0"; then
    log "更新自身：$0"
    install -m 0755 "$STAGE/ufp-apply-deploy" "$0"
  fi
fi

# 3) 交给包里的部署逻辑（安装或升级 + 健康检查 + 回滚）
UFP_DEPLOY_VERSION="${UFP_DEPLOY_VERSION:-unknown}" \
UFP_DEPLOY_DOMAIN="${UFP_DEPLOY_DOMAIN:-}" \
  sh "$STAGE/remote-deploy.sh" "$STAGE"
