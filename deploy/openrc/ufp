#!/sbin/openrc-run
# ufp 的 OpenRC 服务脚本（Alpine）
#
# 安装：
#   install -m 0755 deploy/openrc/ufp /etc/init.d/ufp
#   rc-update add ufp default
#   rc-service ufp start
#
# 升级（不断流）：把新二进制放到 /usr/local/bin/ufp.new，然后
#   rc-service ufp upgrade
# 新进程靠 SO_REUSEPORT 先接管监听，旧进程排空在途请求后自己退出。
#
# 注意：用 supervise-daemon 托管，崩溃会被自动拉起（这是「强稳定」的第一道保险）。

name="ufp"
description="统一 LLM 中转网关"

command="/usr/local/bin/ufp"
command_args="serve"
command_user="ufp:ufp"
command_background=true
supervisor="supervise-daemon"
respawn_delay=3
respawn_max=0
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/ufp/stdout.log"
error_log="/var/log/ufp/stderr.log"

# 进程级配置（运行期配置在 SQLite 里，后台可改、即时生效）
UFP_LISTEN="${UFP_LISTEN:-127.0.0.1:8787}"
UFP_DB="${UFP_DB:-/var/lib/ufp/ufp.db}"
UFP_LOG_DIR="${UFP_LOG_DIR:-/var/log/ufp}"
UFP_MAX_BODY_BYTES="${UFP_MAX_BODY_BYTES:-33554432}"
UFP_MAX_INFLIGHT="${UFP_MAX_INFLIGHT:-32}"
UFP_DRAIN_SECONDS="${UFP_DRAIN_SECONDS:-600}"
UFP_WORKERS="${UFP_WORKERS:-2}"
# UFP_LOG=info,ufp=debug 可以调日志级别

depend() {
    need net
    after firewall
}

start_pre() {
    checkpath --directory --owner "${command_user%:*}:${command_user#*:}" --mode 0750 \
        "$(dirname "$UFP_DB")" "$UFP_LOG_DIR"
}

stop_pre() {
    # 排空期间的日志留在 stderr.log，方便确认「还在处理在途请求」
    einfo "正在等待在途请求结束（最多 ${UFP_DRAIN_SECONDS}s）"
}

# 无缝升级：新进程先起（SO_REUSEPORT 接管监听），再让旧进程排空退出。
upgrade() {
    ebegin "启动新版本 ${command}.new"
    if [ ! -x "${command}.new" ]; then
        eend 1 "${command}.new 不存在（先把新二进制放过去）"
        return 1
    fi
    # 先备份当前二进制，再把新的挪到位
    cp -f "$command" "${command}.old" 2>/dev/null || :
    mv -f "${command}.new" "$command" || { eend 1 "替换二进制失败"; return 1; }
    chmod 0755 "$command"

    # 起一个新进程（它与旧进程同时监听同一端口）
    start-stop-daemon --start --quiet --background \
        --make-pidfile --pidfile "${pidfile}.new" \
        --user "$command_user" \
        --env UFP_LISTEN="$UFP_LISTEN" --env UFP_DB="$UFP_DB" \
        --env UFP_LOG_DIR="$UFP_LOG_DIR" --env UFP_MAX_BODY_BYTES="$UFP_MAX_BODY_BYTES" \
        --env UFP_MAX_INFLIGHT="$UFP_MAX_INFLIGHT" --env UFP_WORKERS="$UFP_WORKERS" \
        --exec "$command" -- $command_args

    # 旧进程收到 SIGTERM 后不再接新连接，等在途请求结束再退出
    if [ -f "$pidfile" ]; then
        old_pid=$(cat "$pidfile")
        einfo "旧进程 $old_pid 开始排空"
        start-stop-daemon --stop --quiet --signal TERM --pidfile "$pidfile" || :
        # 等它退出（最多 10 分钟），期间新进程一直在服务
        i=0
        while [ -d "/proc/$old_pid" ] && [ $i -lt 600 ]; do
            sleep 1
            i=$((i + 1))
        done
        if [ -d "/proc/$old_pid" ]; then
            ewarn "旧进程仍在运行（可能有很长的流式请求），它自己会在排空超时后退出"
        fi
    fi

    # 把新进程的 pid 文件接过来，后续操作针对新进程
    mv -f "${pidfile}.new" "$pidfile" 2>/dev/null || :
    eend 0 "升级完成"
}
